NODE_ENV=development
PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USER=jungle
DATABASE_PASSWORD=change_me
DATABASE_NAME=jungle_db
# Debug TypeORM (queries no log). Uso exclusivo de diagnóstico — não liga em produção.
TYPEORM_LOGGING=false

# LocalStack SQS (sem credenciais AWS reais)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_MAIN_QUEUE_URL=http://localhost:4566/000000000000/jungle-wager-events
SQS_DLQ_URL=http://localhost:4566/000000000000/jungle-wager-events-dlq
SQS_INBOUND_QUEUE_URL=http://localhost:4566/000000000000/jungle-wager-transactions.fifo
SQS_INBOUND_DLQ_URL=http://localhost:4566/000000000000/jungle-wager-transactions-dlq.fifo
SQS_VISIBILITY_TIMEOUT_SECONDS=30
# Fonte única de redrive (app sqsEnv + LocalStack init-sqs.sh via Compose)
SQS_MAX_RECEIVE_COUNT=5
SQS_RECEIVE_WAIT_SECONDS=1
SQS_RECEIVE_MAX_MESSAGES=10
OUTBOX_PUBLISHER_BATCH_SIZE=10
OUTBOX_CLAIM_LEASE_SECONDS=60

# Workers (loops Outbox/Inbox/Inbound/Pending) — true nos containers app-1/2/3
WORKERS_ENABLED=false
# Defaults do código (Compose app-* sobrescreve com 400 / 300 — ver README/OPS_RUNBOOK)
WORKER_OUTBOX_INTERVAL_MS=500
WORKER_INBOX_INTERVAL_MS=500
WORKER_INBOUND_INTERVAL_MS=500
WORKER_PENDING_INTERVAL_MS=1000
PENDING_REFERENCE_BATCH_SIZE=10
# Default do código = 30s (Compose app-* usa 15 — override, não default universal)
PENDING_REFERENCE_LEASE_SECONDS=30
SHUTDOWN_DRAIN_MS=10000
INSTANCE_ID=local-dev

# --- Exclusivo de testes (não é config de runtime de produção) ---
# Hold artificial no consumer para forçar drain_timeout (C3). Sempre 0 fora de teste.
SHUTDOWN_TEST_HOLD_MS=0
# Bases HTTP das 3 instâncias Docker (suíte multi-instance / scrape).
MULTI_INSTANCE_URL_1=http://127.0.0.1:3001
MULTI_INSTANCE_URL_2=http://127.0.0.1:3002
MULTI_INSTANCE_URL_3=http://127.0.0.1:3003
# Prometheus no host (suíte prometheus-scrape).
PROMETHEUS_URL=http://127.0.0.1:9090
